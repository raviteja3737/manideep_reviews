// Cloudflare Workers static-asset deploy for "A Reader's First Review".
// Two ways to ship this:
//  1. CLI (anytime, no repo connection needed):
//       npm run build
//       npx wrangler deploy        (needs CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID in your env — see .env.cloudflare)
//  2. Repo-connected builds: connect GitHub repo `raviteja3737/manideep_reviews`
//     in Cloudflare Dashboard → Workers & Pages → Create → Import an existing repo.
//     Build command: `npm run build`. Deploy command: `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manideep-reviews",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "single-page-application"
  }
}
