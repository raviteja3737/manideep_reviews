// "A Reader's First Review" — static page + feedback API on Cloudflare Workers.
//
// One-time setup (before the first deploy):
//   1. Create the database:
//        npx wrangler d1 create manideep-reviews
//      …or in the Dashboard: Workers & Pages → D1 SQL Database → Create.
//      Copy its `database_id` into the placeholder below.
//   2. Apply the schema:
//        npx wrangler d1 execute manideep-reviews --remote --file=d1/schema.sql
//      (needs CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID — see .env.cloudflare)
//
// Deploy:
//   npm run build
//   npx wrangler deploy
//
// Local dev (full stack: static page + API + local D1 database):
//   npx wrangler d1 execute manideep-reviews --local --file=d1/schema.sql
//   npx wrangler dev
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "first-review",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Ensure the preview URL <name>.<subdomain>.workers.dev is enabled.
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // "none": requests that don't match a file (e.g. /api/feedback) or a
    // 404.html page are forwarded to the Worker script above, which serves
    // the API and falls back to out/404.html for unknown paths.
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manideep-reviews",
      "database_id": "c0d0250e-9f87-43df-b6c8-6b06e07d20f0"
    }
  ]
}
